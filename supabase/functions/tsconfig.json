{
  // Typechecks the Edge Functions on Node: npx tsc -p supabase/functions
  // (the legacy send-queue-notification uses URL imports and is not included).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "npm:@supabase/supabase-js@2": ["../../node_modules/@supabase/supabase-js"]
    }
  },
  "include": ["deno.d.ts", "_shared/**/*.ts", "send-notifications/**/*.ts"]
}
