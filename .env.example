# Copy to .env and fill in. .env is git-ignored; never commit it.
#
# Everything in this file is compiled into the mobile app binary and can be
# extracted by anyone who installs the app. Only public, client-safe values
# belong here:
#   - SUPABASE_ANON_KEY must be the anon (or sb_publishable_...) key.
#   - NEVER put the service_role key (or sb_secret_...), a database password,
#     or any other server-side secret in this file. Those bypass RLS and live
#     only in server environments (Edge Function secrets, CI secrets).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
